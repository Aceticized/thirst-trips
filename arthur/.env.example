# Copy this file to .env and fill in the token.
DJANGO_UPLOAD_TOKEN=

# Where the Django server is. When Django runs on this same PC, use the local address
# (no tunnel needed, because phones only talk to this Node server, which calls Django).
DJANGO_API_URL=http://127.0.0.1:8000/api/nearby/

# Permanent address (thirsttrips-ua.ca). Paste the Cloudflare tunnel token here, the long
# string starting with eyJ. Leave it empty to use a temporary random address instead.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=https://thirsttrips-ua.ca
