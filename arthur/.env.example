# Copy this file to arthur/.env (that file is ignored by Git, so never commit it).
# The Node server in arthur/home reads it when it starts. Restart the server after editing.

# ---------- Cloudflare tunnel (puts the site on thirsttrips-ua.ca) ----------
# Token of your named tunnel: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the long
# string that starts with "eyJ". The tunnel needs two public hostnames:
#   thirsttrips-ua.ca       ->  http://localhost:3000   (this Node server)
#   data.thirsttrips-ua.ca  ->  http://localhost:8000   (Django)
# Leave the token empty to get a temporary random trycloudflare.com address instead.
CLOUDFLARE_TUNNEL_TOKEN=

# The public address printed in the console once the tunnel is connected.
PUBLIC_URL=https://thirsttrips-ua.ca

# ---------- Django ----------
# Where Django runs. Use the local address when Django is on the same PC as this server (the
# normal setup): no tunnel is needed for this hop, so it keeps working even if the tunnel is down.
# The Node server calls Django for the fountain list and for the login, account, leaderboard and
# achievements pages. Only the "/api/nearby/" ending matters for the fountain list.
DJANGO_API_URL=http://127.0.0.1:8000/api/nearby/

# ---------- Optional ----------
# Port of the Node server. The tunnel and the README assume 3000.
# PORT=3000

# Show the fountains in arthur/home/data/sample-fountains.json instead of asking Django.
# USE_SAMPLE_DATA=1

# Old token-based upload (POST /api/facilities/create/). The app's uploader no longer uses it,
# because uploads are now made by logged-in players. Only set these if you still call that
# endpoint yourself; DJANGO_UPLOAD_TOKEN must equal the UPLOAD_TOKEN set for Django.
# DJANGO_UPLOAD_TOKEN=

# Interior snapshots: photos the navigator sends (only from people who agreed) are saved here.
# Default is InteriorDevelopment/Pictures in the repository.
# INTERIOR_PICTURES_DIR=C:\path\to\a\folder
# Stop saving once the folder holds this many megabytes (default 2000).
# INTERIOR_MAX_MB=2000
