# Copy this file to .env and fill in the token.
DJANGO_UPLOAD_TOKEN=

# Optional: only needed if the ngrok address changes.
# DJANGO_API_URL=https://partridge-stubble-even.ngrok-free.dev/api/nearby/

# Permanent address (thirsttrips-ua.ca). Paste the Cloudflare tunnel token here, the long
# string starting with eyJ. Leave it empty to use a temporary random address instead.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=https://thirsttrips-ua.ca
